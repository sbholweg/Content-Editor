# Copy this file to ".env" and fill in what you need.

# Password people type to use the editor. Recommended, and required if you share a link to it.
APP_PASSWORD=

# Claude API key (https://console.anthropic.com). Optional: without it, hooks, key words and
# captions use simple built-in rules instead of Claude.
ANTHROPIC_API_KEY=

# Where videos, your library and settings are saved. Leave this out on your own computer
# (they go in the "data" folder here). On Railway, set it to the volume path, e.g. /data
# DATA_DIR=/data

# Speech-to-text model: base.en (fast) or small.en (more accurate, slower).
# WHISPER_MODEL=base.en

# Which sites may show the editor inside an iframe, e.g. "https://yourdomain.com". Default allows any.
# EMBED_ALLOWED_ORIGINS=
