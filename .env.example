# Password people type to use the editor. Strongly recommended once it's online.
APP_PASSWORD=

# Claude API key (https://console.anthropic.com). Optional: without it, highlights use simple built-in rules.
ANTHROPIC_API_KEY=

# Where videos and settings are saved. On Railway, point this at a mounted volume (e.g. /data).
DATA_DIR=/data

# Speech-to-text model: base.en (fast) or small.en (more accurate, slower).
WHISPER_MODEL=base.en

# Which sites may show the editor inside an iframe, e.g. "https://yourdomain.com". Default allows any.
EMBED_ALLOWED_ORIGINS=
