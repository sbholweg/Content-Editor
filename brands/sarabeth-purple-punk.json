      "role": "accent"
    }
  ],
  "fonts": {
    "headline": "Anton",
    "body": "DM Sans",
    "accent": "Instrument Serif"
  },
  "voice": {
    "tone": [
      "bold",
      "colorful",
      "out loud",
      "unapologetic",
      "rebellious",
      "confident",
      "encouraging"
    ]
  },
  "story": "Purple Punk v5: bold, clean and real. Loud where it counts, calm everywhere else. Shell and white backgrounds, Ink headlines in Anton caps. One italic Instrument Serif word per headline gets a Volt Lime swipe with Ink text. Shock Violet blocks carry White text for the main moment; Lilac for soft cards and stickers. Lime is for small highlights and labels only and always has Ink text. Tiny labels in IBM Plex Mono. One or two offset-shadow blocks per page. Avoid: light text on lime, stars or starbursts, the lightning bolt outside the logo, more than one italic word at a time.",
  "defaultStyle": {
    "font": "DM Sans",
    "displayFont": "Anton",
    "hookColor": "#FFFFFF",
    "hookLayout": "headline",
    "hookDurationMs": 3000,
    "textColor": "#FFFFFF",
    "outlineColor": "#111014",
    "highlightColor": "#B14EFF",
    "highlightTextColor": "#FFFFFF",
    "style": "pill",
    "captionMode": "phrase",
    "textEffect": "shadow",
    "position": "bottom",
    "wordsPerLine": 3,
    "uppercase": false,
    "fontSize": 66,
    "zoomJumps": true,
    "speed": 1.2,
    "accentFont": "Instrument Serif",
    "hookAccent": "block",
    "captionAnimation": "pop",
    "accentColor": "#C1FF72",
    "accentTextColor": "#111014"
  },
  "addLook": {
